# Server
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL=
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT=30000

# Session
SESSION_SECRET=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# App
CLIENT_URL=http://localhost:5173

# ==============================================================================
# Role Credentials (auto-migrated/seeded to database on startup & migration)
# Format per role: <PREFIX>_EMAIL, <PREFIX>_PASSWORD, <PREFIX>_ROLE, <PREFIX>_NAME
# ==============================================================================

# 1. Super Admin (System Administrator)
ADMIN_EMAIL=admin@asgard-iri.org
ADMIN_PASSWORD=AdminPass123!
ADMIN_ROLE=super_admin
ADMIN_NAME=Super Admin

SUPERADMIN_EMAIL=superadmin@asgard-iri.org
SUPERADMIN_PASSWORD=SuperAdminPass123!
SUPERADMIN_ROLE=super_admin
SUPERADMIN_NAME=Super Admin

SUPER_ADMIN_EMAIL=superadmin@asgard-iri.org
SUPER_ADMIN_PASSWORD=SuperAdminPass123!
SUPER_ADMIN_ROLE=super_admin
SUPER_ADMIN_NAME=Super Admin

